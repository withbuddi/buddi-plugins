{
  "name": "@withbuddi/plugin-developer",
  "version": "0.1.1",
  "description": "A workspace an agent may read, edit and run code in, bounded to one directory the owner named.",
  "keywords": [
    "buddi-plugin"
  ],
  "author": {
    "name": "withbuddi",
    "url": "https://withbuddi.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://withbuddi.com/plugins/developer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withbuddi/buddi-plugins.git",
    "directory": "developer"
  },
  "bugs": "https://github.com/withbuddi/buddi-plugins/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "buddi": {
    "name": "developer",
    "manifest": "manifest",
    "core": ">=0.1.0",
    "uses": [
      "files",
      "secrets"
    ],
    "hostApi": "^1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "playwright-core": "1.63.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@buddi/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@buddi/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo",
    "migrations",
    "skills",
    "buddi.md"
  ]
}
