{
  "name": "@withbuddi/plugin-news",
  "version": "0.2.5",
  "description": "The news on the topics you follow, from feeds you can see, grouped into stories on your own machine.",
  "keywords": [
    "buddi-plugin"
  ],
  "author": {
    "name": "withbuddi",
    "url": "https://withbuddi.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://withbuddi.com/plugins/news",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withbuddi/buddi-plugins.git",
    "directory": "news"
  },
  "bugs": "https://github.com/withbuddi/buddi-plugins/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "buddi": {
    "name": "news",
    "manifest": "manifest",
    "core": ">=0.1.0",
    "uses": [
      "http",
      "assets",
      "onnx"
    ],
    "optional": {
      "speech": "^0.1.3"
    },
    "hostApi": "^1.33"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@buddi/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@buddi/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "pg": "^8.13.1"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo",
    "migrations",
    "buddi.md"
  ]
}
