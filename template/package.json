{
  "name": "buddi-plugin-template",
  "version": "0.1.0",
  "description": "A buddi plugin: template.",
  "keywords": [
    "buddi-plugin"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "buddi": {
    "name": "template",
    "manifest": "manifest",
    "core": ">=0.1.0",
    "uses": [],
    "hostApi": "^1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@buddi/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@buddi/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "migrations",
    "buddi.md"
  ]
}
