{
  "name": "@withbuddi/plugin-weather",
  "version": "0.1.0",
  "description": "The weather for the places you save, from Open-Meteo with no key, and a word when something severe is coming.",
  "keywords": [
    "buddi-plugin"
  ],
  "license": "Apache-2.0",
  "homepage": "https://withbuddi.com/plugins/weather",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withbuddi/buddi-plugins.git",
    "directory": "weather"
  },
  "bugs": "https://github.com/withbuddi/buddi-plugins/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "buddi": {
    "name": "weather",
    "manifest": "manifest",
    "core": ">=0.1.0",
    "uses": [
      "http",
      "owner:notify"
    ],
    "hostApi": "^1.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@buddi/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@buddi/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo",
    "migrations",
    "buddi.md"
  ]
}
